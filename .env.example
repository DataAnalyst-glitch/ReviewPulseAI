# Copy this file to .env and fill in real values. Never commit .env.

# --- Module 1: Data Ingestion ---
# Optional. If blank, ingestion falls back to CSV upload / bundled sample data.
# e.g. a SerpApi or Rainforest API key for live Amazon review lookups.
REVIEW_API_KEY=

# --- Module 3: Agentic Analysis ---
GEMINI_API_KEY=

# --- Module 4: Presentation Layer ---
# Leave unset/blank locally for full functionality (any product ID, any
# uploaded CSV). Set to "true" only on the public Streamlit Cloud
# deployment, so visitors can only analyze the bundled sample products —
# see app.py's DEMO_MODE gate. This is a UI-layer business gate, not a
# security boundary.
DEMO_MODE=

# --- Module 2/4: still deferred, using local storage instead ---
# SUPABASE_URL=
# SUPABASE_KEY=
